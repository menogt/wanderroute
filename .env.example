# Copy to .env and fill in real values. .env is gitignored - never commit it.

# --- Supabase (public by design; protected by Row Level Security) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Groq (AI itinerary generation) - SERVER-SIDE ONLY ---
# Read by netlify/functions/generate-itinerary.js via process.env.
# Never use a VITE_ prefix here: VITE_* is inlined into the public bundle.
GROQ_API_KEY=

# --- Foursquare Places (server-side only: vite dev proxy + netlify function) ---
VITE_FOURSQUARE_API_KEY=

# --- Optional affiliate tracking (links work without these) ---
VITE_BOOKING_AFFILIATE_ID=
VITE_AGODA_CID=
